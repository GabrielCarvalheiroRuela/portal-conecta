# Copie para .env e preencha. O .env não vai para o git; este arquivo vai.
# Nunca preencha credenciais aqui.

# Alvo do proxy de desenvolvimento. Em produção quem faz o proxy é o nginx.
# API local:      http://localhost:3001
# API publicada:  https://monint.citelsoftware.com.br
VITE_API_TARGET=http://localhost:3001

# n8n que responde o controle de acesso (/acesso -> webhook Portal_Acesso). Só no desenvolvimento;
# em produção quem faz o proxy é o nginx.
# n8n de desenvolvimento: https://automakerdev.citelsoftware.com.br
VITE_N8N_TARGET=https://automakerdev.citelsoftware.com.br

# Só no npm run dev: recursos restritos (separados por vírgula) que o menu mostra sem consultar a
# tabela portal_acessos. Não libera dados: o n8n continua checando cada chamada.
VITE_RECURSOS_DEV=
# Para ver a aba Workflows e a importação no dev: VITE_RECURSOS_DEV=workflows,workflows-importar

# Só no npm run dev: ADMIN faz a tela tratar quem entrou como admin, mostrando as abas de admin
# (Plataformas, Nova integração, Workflows). É só visual: a API continua barrando pelo USR_PERFIL.
VITE_PERFIL_DEV=

# Client ID do projeto no Google Cloud (Credentials > OAuth 2.0 Client IDs > Web application).
# Não é segredo: é público por design, diferente do client secret — que esta tela não usa.
#
# Precisa ser IDÊNTICO ao api.security.google.client-id da API. Ele é o audience do ID Token, e
# o backend recusa o login se os dois divergirem ("audience mismatch").
#
# A origem em que a tela roda tem de estar em "Authorized JavaScript origins" no Console:
#   http://localhost:4200            (desenvolvimento)
#   https://onboarding.citelsoftware.com.br   (produção)
VITE_GOOGLE_CLIENT_ID=

# Só no npm run dev: com 1, a aba Workflows usa dados simulados (instâncias, filtros, comuns, ZIP vazio) em vez do n8n,
# então dá para ver e mexer na tela com ou sem login pelo Google. Vazio = usa o n8n de VITE_N8N_TARGET.
VITE_MOCK_WF=

# Só no dev: onde está o workflow Portal_WF_Importar (padrão: o mesmo n8n de VITE_N8N_TARGET).
# Para testar a importação sem tocar na produção: VITE_N8N_IMPORTAR_TARGET=https://automakerdev.citelsoftware.com.br
VITE_N8N_IMPORTAR_TARGET=
