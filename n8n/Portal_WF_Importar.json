    {
      "parameters": {
        "jsCode": "const req = $input.first().json;\nconst auth = String((req.headers || {}).authorization || '').trim();\nconst jwt = auth.split(' ').pop().split('.')[1] || '';\nlet email = '';\ntry {\n  email = String(JSON.parse(Buffer.from(jwt, 'base64url').toString('utf8')).sub || '').trim().toLowerCase();\n} catch (e) {\n  email = '';\n}\nconst corpo = (req.body && typeof req.body === 'object') ? req.body : {};\nconst t = v => String(v || '').trim();\nreturn [{ json: { auth, email, acao: t(corpo.acao).toLowerCase(), instancia: t(corpo.instancia).toLowerCase(), itens: Array.isArray(corpo.itens) ? corpo.itens : null } }];"
      },
