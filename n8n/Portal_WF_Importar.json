    {
      "parameters": {
        "jsCode": "const enviados = $('Preparar Pastas').all();\nconst respostas = $input.all();\nconst resultados = enviados.map((it, i) => {\n  const chave = it.json.chave;\n  const r = (respostas[i] || {}).json || {};\n  if (r.error) { return { chave, erro: String((r.error && r.error.message) || r.error).slice(0, 300) }; }\n  const status = Number(r.statusCode);\n  const corpo = (r.body && typeof r.body === 'object') ? r.body : {};\n  if (status >= 200 && status < 300 && corpo.id) { return { chave, id: String(corpo.id) }; }\n  const motivo = corpo.message ? String(corpo.message) : JSON.stringify(corpo);\n  return { chave, erro: ('HTTP ' + (status || '?') + ' - ' + motivo).slice(0, 400) };\n});\nreturn [{ json: { corpo: JSON.stringify({ resultados }) } }];"
      },
