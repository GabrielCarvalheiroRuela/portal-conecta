    {
      "parameters": {
        "jsCode": "const cred = $('Ler Credencial').first().json;\nconst eu = $('Validar Token no Monint').first().json.body || {};\nconst admin = String(eu.perfil || '').trim().toUpperCase() === 'ADMIN';\nconst email = String(eu.email || cred.email).trim().toLowerCase();\n\n// Quem pode importar: todo usuario ADMIN, ou so os e-mails desta lista (vazia = todo ADMIN).\nconst EMAILS_PERMITIDOS = [];\n\n// Instancias que aceitam importacao. Para liberar outra, acrescente uma linha aqui, crie os 3 nodes HTTP dela\n// (Criar Pasta, Criar Workflow, Atualizar Workflow, com a credencial de ESCRITA daquela instancia) e uma saida\n// nos 3 nodes \"Qual Instancia?\". projetoId e o ID do projeto Personal (na URL do n8n: /projects/<ID>/workflows).\nconst INSTANCIAS = {\n  automakerdev_geral: { nome: 'Automaker Dev Geral', baseUrl: 'https://automakerdev.citelsoftware.com.br', projetoId: 'zQ1MIpWe3DPkm3hw' }\n};\n\nconst emailOk = EMAILS_PERMITIDOS.length === 0 || EMAILS_PERMITIDOS.includes(email);\nconst existe = Object.prototype.hasOwnProperty.call(INSTANCIAS, cred.instancia);\nconst instancias = Object.keys(INSTANCIAS).map(id => ({ id, nome: INSTANCIAS[id].nome }));\nreturn [{ json: {\n  permitido: admin && emailOk,\n  email,\n  acao: cred.acao,\n  instancia: cred.instancia,\n  itens: cred.itens,\n  instancias,\n  baseUrl: existe ? INSTANCIAS[cred.instancia].baseUrl : '',\n  projetoId: existe ? INSTANCIAS[cred.instancia].projetoId : ''\n} }];"
      },
