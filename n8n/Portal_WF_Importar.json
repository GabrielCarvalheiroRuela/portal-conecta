    {
      "parameters": {
        "jsCode": "const ctx = $('Checar Permissao').first().json;\nconst ACOES = ['instancias', 'criar-pastas', 'criar-workflows', 'atualizar-workflows'];\nconst falha = (status, erro) => [{ json: { ok: false, status, erro } }];\n\nif (!ACOES.includes(ctx.acao)) { return falha(400, 'Ação inválida'); }\nif (ctx.acao === 'instancias') { return [{ json: { ok: true, acao: ctx.acao } }]; }\nif (!ctx.baseUrl) { return falha(403, 'A importação não está liberada para esta instância.'); }\n\nconst itens = ctx.itens;\nif (!Array.isArray(itens) || itens.length < 1 || itens.length > 25) { return falha(400, 'Envie de 1 a 25 itens por pedido.'); }\n\nconst objeto = v => v !== null && typeof v === 'object' && !Array.isArray(v);\nconst idOk = v => typeof v === 'string' && /^[A-Za-z0-9_-]{1,64}$/.test(v);\nconst vazio = v => v === null || v === undefined;\nconst PERMITIDOS = ['name', 'nodes', 'connections', 'settings', 'pinData', 'staticData', 'description', 'nodeGroups'];\n\nfor (let i = 0; i < itens.length; i++) {\n  const it = itens[i];\n  const onde = 'item ' + (i + 1) + ': ';\n  if (!objeto(it) || typeof it.chave !== 'string' || it.chave.length < 1 || it.chave.length > 600) { return falha(400, onde + 'chave inválida.'); }\n  if (ctx.acao === 'criar-pastas') {\n    if (typeof it.nome !== 'string' || !it.nome.trim() || it.nome.length > 128) { return falha(400, onde + 'nome de pasta inválido (1 a 128 caracteres).'); }\n    if (!vazio(it.paiId) && !idOk(it.paiId)) { return falha(400, onde + 'pasta-mãe inválida.'); }\n    continue;\n  }\n  const w = it.workflow;\n  if (!objeto(w)) { return falha(400, onde + 'falta o workflow.'); }\n  if (typeof w.name !== 'string' || !w.name.trim() || w.name.length > 128) { return falha(400, onde + 'nome do workflow inválido (1 a 128 caracteres).'); }\n  if (!Array.isArray(w.nodes) || w.nodes.length > 3000) { return falha(400, onde + 'lista de nodes inválida.'); }\n  if (!objeto(w.connections) || !objeto(w.settings)) { return falha(400, onde + 'connections e settings são obrigatórios.'); }\n  const estranho = Object.keys(w).find(k => !PERMITIDOS.includes(k));\n  if (estranho) { return falha(400, onde + 'propriedade não permitida: ' + estranho + '.'); }\n  if (JSON.stringify(w).length > 8000000) { return falha(400, onde + 'workflow grande demais (limite de 8 MB).'); }\n  if (ctx.acao === 'criar-workflows') {\n    if (!vazio(it.pastaId) && !idOk(it.pastaId)) { return falha(400, onde + 'pasta inválida.'); }\n  } else if (!idOk(it.id)) {\n    return falha(400, onde + 'ID do workflow inválido.');\n  }\n}\nreturn [{ json: { ok: true, acao: ctx.acao } }];"
      },
